{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhiki",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "86c29ed8-fdc4-4cd6-89e3-54c2688b11d4","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9c391a5073e34cbd8237db6ff8a5f051" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
